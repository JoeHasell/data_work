. do fetch_population.do 

. *******************************************************
. * fetch_population.do
. * Download population data from WID
. * Fast - no percentile data
. *******************************************************
. 
. clear all

. set more off

. 
. local target_year = 2023

. local outdir = "/Users/joehasell/Documents/GitHub/data_work/global_inequality
> _pip_wid/inputs"

. 
. *------------------------------------------------------
. * Download total and adult population (npopul)
. *------------------------------------------------------
. 
. wid, indicators(npopul) ///
>     areas(_all)          ///
>     years(`target_year') ///
>     ages(992 999)        ///
>     population(i)        ///
>     clear

